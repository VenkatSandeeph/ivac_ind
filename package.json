{
  "name": "us-visa-scheduling-automation",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:exe": "npm run build && npx @yao-pkg/pkg --public --public-packages \"*\" -t node24-win-x64 -o dist/ivac.exe dist/index.js",
    "build:release": "npm run build:exe && copy /Y config.example.json dist\\config.local.json",
    "ui:start": "electron ui/main.js",
    "prepare": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "camoufox-js": "^0.12.0",
    "ghost-cursor": "^1.4.2",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^32.0.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "assets": [
      "node_modules/playwright/node_modules/playwright-core/browsers.json",
      "node_modules/playwright-core/browsers.json"
    ]
  }
}
